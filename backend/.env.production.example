# Copy these settings into the production secret manager or protected
# EnvironmentFile. Replace every CHANGE_ME value; do not commit real secrets.
FLASK_ENV=production
FLASK_DEBUG=false
DEBUG=false
SECRET_KEY=CHANGE_ME_generate_a_unique_random_secret_of_at_least_48_characters
JWT_SECRET_KEY=CHANGE_ME_generate_a_different_random_secret_of_at_least_48_characters

# Use a dedicated runtime role and URL-encode reserved characters in its password.
# For managed PostgreSQL, require TLS and use the provider's CA verification options.
DATABASE_URL=postgresql+psycopg://memorybook_app:CHANGE_ME_URL_ENCODED_PASSWORD@db.example.com:5432/memorybook?sslmode=verify-full&sslrootcert=/etc/ssl/certs/provider-ca.pem
CORS_ORIGINS=https://www.example.com
PUBLIC_APP_URL=https://www.example.com
PUBLIC_API_URL=https://www.example.com

JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_DOMAIN=
TRUSTED_PROXY_HOPS=1
LOG_LEVEL=INFO

# One Gunicorn worker is recommended with the in-process job runner until
# cross-process job claiming is introduced and load-tested.
BACKGROUND_JOB_BACKEND=inprocess
BACKGROUND_JOB_WORKERS=2

# Production rate limiting must be shared across processes.
RATE_LIMIT_STORAGE_URI=redis://memorybook_rate:CHANGE_ME_URL_ENCODED_PASSWORD@127.0.0.1:6379/2

# Persistent and private. The service account must own this path; never expose
# it through nginx. Use private S3 storage instead when deploying multiple hosts.
ASSET_STORAGE_BACKEND=filesystem
ASSET_LOCAL_DIRECTORY=/var/lib/memorybook/assets
ASSET_S3_PRESIGNED_URL_TTL=900
PROJECT_UPLOAD_RETENTION_DAYS=30

AUTH_EMAIL_MODE=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=books@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

PAYMENT_DEFAULT_CURRENCY=PKR
PAYMENT_PRIMARY_GATEWAY=manual
MANUAL_BANK_NAME=CHANGE_ME
MANUAL_BANK_ACCOUNT_TITLE=CHANGE_ME
MANUAL_BANK_ACCOUNT_NUMBER=CHANGE_ME
MANUAL_JAZZCASH_NUMBER=
MANUAL_EASYPAISA_NUMBER=
STRIPE_ENABLED=false
PAYFAST_ENABLED=false
JAZZCASH_ENABLED=false
EASYPAISA_ENABLED=false
