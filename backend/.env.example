FLASK_ENV=development
SECRET_KEY=replace-with-a-unique-random-value
JWT_SECRET_KEY=replace-with-a-different-unique-random-value
DATABASE_URL=postgresql+psycopg://postgres:Ahmad9803@localhost:5432/memorybook
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_STORAGE_URI=memory://
LOG_LEVEL=INFO
TRUSTED_PROXY_HOPS=0
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_DOMAIN=
AUTH_OTP_TTL_MINUTES=10
AUTH_RESET_TTL_MINUTES=30
AUTH_EMAIL_MODE=smtp
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=https://api.example.com
# Pakistani payment providers remain disabled until merchant-specific contracts,
# credentials, callback verification, and sandbox transactions have been verified.
PAYMENT_DEFAULT_CURRENCY=PKR
PAYMENT_PRIMARY_GATEWAY=payfast
PAYFAST_ENABLED=false
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_SECRET=
PAYFAST_API_BASE_URL=
PAYFAST_CONTRACT_VERIFIED=false
PAYFAST_PAYMENT_METHODS=
JAZZCASH_ENABLED=false
JAZZCASH_MODE=sandbox
JAZZCASH_CHECKOUT_CONTRACT_VERIFIED=false
JAZZCASH_CALLBACK_CONTRACT_VERIFIED=false
JAZZCASH_PAYMENT_METHODS=
EASYPAISA_ENABLED=false
EASYPAISA_MODE=sandbox
EASYPAISA_STORE_ID=
EASYPAISA_MERCHANT_SECRET=
# Stripe is available only when explicitly enabled, credentials are configured,
# and the payment webhook secret is set for server-side verification.
STRIPE_ENABLED=false
STRIPE_PAYMENT_METHODS=card
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# JazzCash merchant credentials are used only by the backend server-to-server API.
# Verify the merchant-specific request, redirect, and callback-signature contract in sandbox before enabling.
JAZZCASH_API_URL=
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_API_VERSION=2.0
JAZZCASH_TXN_TYPE=MPAY
JAZZCASH_REDIRECT_HOSTS=sandbox.jazzcash.com.pk,jazzcash.com.pk
PAYMENT_RETURN_URL=https://api.example.com/api/v1/payments/webhooks/jazzcash
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
ASSET_S3_ENDPOINT_URL=
ASSET_S3_REGION=us-east-1
ASSET_S3_BUCKET=
ASSET_S3_ACCESS_KEY_ID=
ASSET_S3_SECRET_ACCESS_KEY=
ASSET_S3_PRESIGNED_URL_TTL=3600
